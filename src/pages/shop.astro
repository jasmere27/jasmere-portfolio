---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { person, links, products, shopCategories, projects } from '../data/site';

const ext = { target: '_blank', rel: 'noopener noreferrer' };
const shopifyUrl = (handle: string) => new URL(`products/${handle}`, links.shopify).href;
const payhipUrl = (code: string) => `https://payhip.com/b/${code}`;
const gumroadUrl = (permalink: string) => new URL(`l/${permalink}`, links.gumroad).href;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Projects that aren't sold as products yet still get a spot below the shop.
const forSale = new Set(products.map((p) => p.demo));
const notForSale = projects.filter((p) => !forSale.has(p.url));
---
<Base title={`Shop — ${person.name}`} description="Source code, website templates and AI guides by Jasmere Paul Calagui, available on Shopify and Payhip.">
  <section class="hero hero--shop wrap" aria-labelledby="shop-title">
    <p class="eyebrow">Jea Labs Shop</p>
    <h1 id="shop-title">Products you can <span class="grad">build on</span></h1>
    <p class="hero__lead">Full source code, ready-to-brand website templates and AI guides from the apps I've built. Try a live demo, then buy right here with secure checkout.</p>
  </section>

  <section class="section section--shop wrap" aria-labelledby="products-title">
    <div class="shop__head">
      <h2 id="products-title" class="sr-only">Products</h2>
      <div class="filters" role="group" aria-label="Filter products" hidden>
        <button type="button" class="filter" data-filter="all" aria-pressed="true">All <span>{products.length}</span></button>
        {shopCategories.map((c) => (
          <button type="button" class="filter" data-filter={slug(c)} aria-pressed="false">
            {c} <span>{products.filter((p) => p.category === c).length}</span>
          </button>
        ))}
      </div>
    </div>

    <ul class="grid" id="products">
      {products.map((p) => (
        <li class="card product" data-category={slug(p.category)}>
          <div class="card__img">
            {p.image ? (
              <Picture src={p.image} alt={p.alt ?? ''} formats={['avif', 'webp']}
                widths={[480, 720, 960]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw" loading="lazy" />
            ) : (
              <div class="product__cover" aria-hidden="true">
                <span>Jea Labs</span>
                <strong>{p.name}</strong>
              </div>
            )}
          </div>
          <div class="card__body">
            <p class="product__cat">{p.category}</p>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
            <p class="product__price">{p.price}</p>
            <a class="btn btn--primary product__buy" href={gumroadUrl(p.gumroad)} {...ext}>Buy Now<span class="sr-only">: {p.name}</span></a>
            <p class="product__alt">
              Also on{' '}
              <a href={shopifyUrl(p.shopify)} {...ext}>Shopify</a>{' · '}
              <a href={gumroadUrl(p.gumroad)} {...ext} data-gumroad-ignore="true">Gumroad</a>{' · '}
              <a href={payhipUrl(p.payhip)} {...ext}>Payhip</a>
            </p>
            {p.demo && (
              <a class="text-link product__demo" href={p.demo} {...ext}>Try the live demo <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens in a new tab)</span></a>
            )}
          </div>
        </li>
      ))}
    </ul>

    <p class="shop__stores muted">
      Prefer another store? Browse everything on{' '}
      <a class="text-link" href={links.shopify} {...ext}>Shopify</a>,{' '}
      <a class="text-link" href={links.payhip} {...ext}>Payhip</a> or{' '}
      <a class="text-link" href={links.gumroad} {...ext}>Gumroad</a>.
    </p>
  </section>

  {notForSale.length > 0 && (
    <section class="section wrap" aria-labelledby="more-title">
      <div class="section__head">
        <h2 id="more-title">More projects</h2>
        <p class="muted">Apps I've built that aren't for sale yet. Each one has a live demo you can try.</p>
      </div>
      <ul class="grid">
        {notForSale.map((p) => (
          <li class="card">
            <a class="card__link" href={p.url} {...ext}>
              <div class="card__img">
                <Picture src={p.image} alt={p.alt} formats={['avif', 'webp']}
                  widths={[480, 720, 960]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw" loading="lazy" />
              </div>
              <div class="card__body">
                <h3>{p.name}</h3>
                <p>{p.description}</p>
                <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
                <span class="card__cta">View Live Demo <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens in a new tab)</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section wrap" aria-labelledby="custom-title">
    <div class="contact">
      <h2 id="custom-title">Need something custom?</h2>
      <p class="muted">I also build websites, business software and AI tools to order. Tell me what you need.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={`mailto:${person.email}`}>Get In Touch</a>
        <a class="btn btn--ghost" href="/#projects">View My Work</a>
      </div>
    </div>
  </section>

  <!-- Gumroad overlay: turns the Buy Now links into an on-page checkout. -->
  <script is:inline src="https://gumroad.com/js/gumroad.js"></script>
  <script>
    const group = document.querySelector<HTMLElement>('.filters')!;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('.filter')];
    const items = [...document.querySelectorAll<HTMLElement>('#products > li')];
    group.hidden = false;
    group.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('.filter');
      if (!btn) return;
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => { li.hidden = f !== 'all' && li.dataset.category !== f; });
    });
  </script>
</Base>
