---
import { Picture } from 'astro:assets';
import '../styles/global.css';
import { person, seo, links, featured, projects, experience, skills, channels, about } from '../data/site';

const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url).href;
const nav = [
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <meta name="theme-color" content="#0F172A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {Astro.site && <link rel="canonical" href={Astro.site.href} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      try { var t = localStorage.getItem('theme-v3'); if (t === 'light' || t === 'dark') d.dataset.theme = t; } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" id="top">
    <div class="wrap nav__inner">
      <a class="nav__brand" href="#top">{person.name}</a>
      <nav aria-label="Primary">
        <ul class="nav__links" id="nav-links">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="nav__actions">
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch to light mode">
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <button class="icon-btn nav__menu" id="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero wrap" aria-labelledby="hero-title">
      <p class="eyebrow">{person.role}</p>
      <h1 id="hero-title">{person.name}</h1>
      <p class="hero__lead">{person.tagline}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#projects">View My Work</a>
        <a class="btn btn--ghost" href="#contact">Get In Touch</a>
      </div>
      <p class="hero__meta">
        {person.focus.join(' · ')}
        <span aria-hidden="true">/</span>
        {person.location}
      </p>
    </section>

    <!-- Featured project -->
    <section class="section wrap" id="projects" aria-labelledby="featured-title">
      <p class="label reveal">Featured Project</p>
      <article class="featured reveal">
        <a class="frame" href={featured.url} {...ext} aria-label={`Open the ${featured.name} live demo (opens in a new tab)`}>
          <div class="frame__bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <code>{featured.displayUrl}</code>
          </div>
          <div class="frame__img">
            <Picture src={featured.image} alt={featured.alt} formats={['avif', 'webp']}
              widths={[640, 960, 1280, 1600]} sizes="(min-width: 1200px) 1120px, 100vw" loading="eager" fetchpriority="high" />
          </div>
        </a>
        <div class="featured__body">
          <div>
            <h2 id="featured-title" class="featured__title">{featured.name}</h2>
            <p class="featured__summary">{featured.summary}</p>
            <p class="muted">{featured.description}</p>
            <ul class="tags">{featured.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div>
            <ul class="checks">{featured.highlights.map((h) => <li>{h}</li>)}</ul>
            <p class="note">{featured.note}</p>
            <a class="btn btn--primary" href={featured.url} {...ext}>View Live Demo <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    </section>

    <!-- Selected projects -->
    <section class="section wrap" aria-labelledby="selected-title">
      <div class="section__head reveal">
        <h2 id="selected-title">Selected Projects</h2>
        <p class="muted">Business software, booking systems and lead tools, each with a live demo you can try.</p>
      </div>
      <ul class="grid">
        {projects.map((p) => (
          <li class="card reveal">
            <a class="card__link" href={p.url} {...ext}>
              <div class="card__img">
                <Picture src={p.image} alt={p.alt} formats={['avif', 'webp']}
                  widths={[480, 720, 960]} sizes="(min-width: 1100px) 360px, (min-width: 700px) 50vw, 100vw" loading="lazy" />
              </div>
              <div class="card__body">
                <h3>{p.name}</h3>
                <p>{p.description}</p>
                <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
                <span class="card__cta">View Live Demo <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens in a new tab)</span></span>
              </div>
            </a>
          </li>
        ))}
        <li class="card card--cta reveal">
          <p class="label">Want the products?</p>
          <p>I also turn these builds into digital products you can get on my Gumroad storefront.</p>
          <a class="text-link" href={links.gumroad} {...ext}>Explore my digital products on Gumroad <span class="arrow" aria-hidden="true">→</span></a>
        </li>
      </ul>
    </section>

    <!-- Experience -->
    <section class="section wrap" id="experience" aria-labelledby="exp-title">
      <div class="section__head reveal"><h2 id="exp-title">Experience</h2></div>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="reveal">
            <p class="timeline__date">{e.date}</p>
            <div>
              <h3>{e.role} <span class="muted">· {e.org}</span></h3>
              <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section class="section wrap" id="skills" aria-labelledby="skills-title">
      <div class="section__head reveal"><h2 id="skills-title">Skills</h2></div>
      <dl class="skills reveal">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Content & product marketing -->
    <section class="section wrap" aria-labelledby="share-title">
      <div class="share reveal">
        <div>
          <p class="label">Content &amp; Product Marketing</p>
          <h2 id="share-title">Build. Launch. Share.</h2>
          <p class="muted">I also built a content workflow that turns my software projects into product demos and promotional videos for YouTube and TikTok.</p>
        </div>
        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a class="channel" href={c.url} {...ext}>
                <span class="channel__platform">{c.platform}</span>
                <span class="channel__handle">{c.handle}</span>
                <span class="channel__desc">{c.description}</span>
                <span class="card__cta">{c.cta} <span class="arrow" aria-hidden="true">→</span><span class="sr-only"> (opens in a new tab)</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- About -->
    <section class="section wrap" id="about" aria-labelledby="about-title">
      <div class="about reveal">
        <h2 id="about-title">About</h2>
        <div>{about.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section wrap" id="contact" aria-labelledby="contact-title">
      <div class="contact reveal">
        <h2 id="contact-title">Have a project or opportunity in mind?</h2>
        <p class="muted">I'm happy to talk about roles, freelance work or a product idea. Email is the fastest way to reach me.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`mailto:${person.email}`}>Get In Touch</a>
          <a class="btn btn--ghost" href={links.gumroad} {...ext}>View My Products</a>
        </div>
        <ul class="contact__links">
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><a href={links.github} {...ext}>GitHub</a></li>
          {links.linkedin && <li><a href={links.linkedin} {...ext}>LinkedIn</a></li>}
          <li><a href={links.youtube} {...ext}>YouTube</a></li>
          <li><a href={links.tiktok} {...ext}>TikTok</a></li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer wrap">
    <p>© {year} {person.name}</p>
    <a href="#top">Back to top ↑</a>
  </footer>

  <script>
    const root = document.documentElement;
    const themeBtn = document.getElementById('theme-toggle')!;
    const syncTheme = () => {
      const dark = root.dataset.theme !== 'light';
      themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      document.querySelector('meta[name="theme-color"]')!.setAttribute('content', dark ? '#0F172A' : '#F9F9F8');
    };
    syncTheme();
    themeBtn.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme-v3', root.dataset.theme); } catch {}
      syncTheme();
    });

    const menuBtn = document.getElementById('menu-toggle')!;
    const menu = document.getElementById('nav-links')!;
    const setMenu = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    menuBtn.addEventListener('click', () => setMenu(!menu.classList.contains('is-open')));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  </script>
</body>
</html>
